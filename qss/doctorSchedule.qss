/* 背景 */
DoctorScheduleWidget {
    background-color: #ffffff;
}

/* 顶部日期文本 */
QLabel#dateLabel {
    font-size: 15px;
    color: #606266;
    margin: 0 30px;
}

/* 上一周/下一周按钮 */
QPushButton#navBtn {
    background-color: #2f7cf6;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-size: 14px;
}
QPushButton#navBtn:hover {
    background-color: #4a8cff;
}
QPushButton#navBtn:pressed {
    background-color: #1a5fc4;
}

/* 表格整体 */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #dcdfe6;
    gridline-color: #dcdfe6; /* 边框线颜色 */
    outline: none;
}

/* 表头（第一行蓝色的部分） */
QHeaderView::section {
    background-color: #409eff;
    color: #ffffff;
    font-weight: bold;
    font-size: 14px;
    border: none;
    border-right: 1px solid #ffffff; /* 表头垂直分割线白色 */
    border-bottom: 1px solid #ffffff;
}

/* 单元格内容居中 */
QTableWidget::item {
    text-align: center;
    border-right: 1px solid #dcdfe6;
    border-bottom: 1px solid #dcdfe6;
    color: #303133;
    font-size: 13px;
}